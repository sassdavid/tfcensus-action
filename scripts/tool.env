# The only tool-specific settings. scripts/install.sh, scripts/run.sh and the tests source this file.
TOOL_NAME=tfcensus
TOOL_REPO=sassdavid/tfcensus
TOOL_SIGNER_WORKFLOW=sassdavid/tfcensus/.github/workflows/release.yml
# renovate: datasource=github-releases depName=sassdavid/tfcensus
TOOL_VERSION=0.6.0

# The commands each mode takes; the first is the default. The commands in TOOL_SARIF_COMMANDS
# also write SARIF and annotations.
TOOL_REPORT_COMMANDS="drift"
TOOL_COMMENT_COMMANDS="drift"
TOOL_SARIF_COMMANDS="drift"
# Flags that comment mode puts before the generated ones.
TOOL_COMMENT_FLAGS=""
# The flag that the from input sets, and a file in that directory that a second flag names when
# it exists: the plans of an earlier terragrunt run --json-out-dir, and its --report-file.
TOOL_FROM_FLAG="--from-json-out-dir"
TOOL_FROM_FILE_FLAG="--report-file"
TOOL_FROM_FILE="report.json"
